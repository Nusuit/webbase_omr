<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".GradeSnapApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GradeSnap"
        android:largeHeap="true">

        <!-- HOME: Exam Project List -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy single-scan entry (kept for compatibility) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Exam project detail + dashboard -->
        <activity
            android:name=".ExamActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Batch processing screen -->
        <activity
            android:name=".ProcessingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Student result detail + split preview -->
        <activity
            android:name=".StudentResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Suspicious review queue -->
        <activity
            android:name=".SuspiciousReviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Zalo-style photo picker -->
        <activity
            android:name=".PhotoPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />

        <!-- Camera crop + rotate preview after capture -->
        <activity
            android:name=".CropRotateActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Legacy result (single scan) -->
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Image preview list (bài làm / đáp án thumbnails) -->
        <activity
            android:name=".ImagePreviewListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Fullscreen single image viewer -->
        <activity
            android:name=".FullscreenImageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Answer key detail + inline edit -->
        <activity
            android:name=".AnswerKeyDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- FileProvider: camera capture + PDF sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
