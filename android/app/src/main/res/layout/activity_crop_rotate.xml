<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Phase 1: Camera ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Camera preview fills available space -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:scaleType="fillCenter"/>

        <!-- Shutter bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="#1A1A1A"
            android:gravity="center">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                app:cornerRadius="36dp"
                android:backgroundTint="#FFFFFF"
                android:text="⬤"
                android:textSize="28sp"
                android:textColor="#1A1A1A"
                android:padding="0dp"
                style="@style/Widget.Material3.Button"/>
        </FrameLayout>
    </LinearLayout>

    <!-- ── Phase 2: Review / Rotate ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/reviewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Captured image -->
        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:background="#111111"/>

        <!-- Review controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Row 1: Xoay trái + Xoay phải + Chụp lại -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRotateLeft"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="↺  Xoay trái"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRotateRight"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="↻  Xoay phải"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetake"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Chụp lại"
                    android:textSize="13sp"
                    app:cornerRadius="24dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Row 2: Dùng ảnh này — full width -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsePhoto"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="✓  Dùng ảnh này"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
